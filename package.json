{
  "name": "studios.boomroom.by",
  "private": true,
  "description": "Сайт и админка репетиционных баз BOOM: расписание, клиенты, бронирование, экономика",
  "scripts": {
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:up": "docker compose -f docker-compose.e2e.yaml up -d --build --wait",
    "e2e:down": "docker compose -f docker-compose.e2e.yaml down -v",
    "e2e:reset": "yarn e2e:down && yarn e2e:up"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^25.6.0",
    "mysql2": "^3.22.2",
    "typescript": "^6.0.3"
  }
}
